<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hoseong.devlog.troubleshooting.TroubleshootingMapper">
  <sql id="filters">
    <where>
      <if test="keyword != ''">
        AND (t.title LIKE CONCAT('%', #{keyword}, '%') ESCAPE '!'
          OR t.symptom LIKE CONCAT('%', #{keyword}, '%') ESCAPE '!'
          OR t.cause LIKE CONCAT('%', #{keyword}, '%') ESCAPE '!'
          OR t.solution LIKE CONCAT('%', #{keyword}, '%') ESCAPE '!'
          OR t.code_snippet LIKE CONCAT('%', #{keyword}, '%') ESCAPE '!')
      </if>
      <if test="tag != ''">
        AND EXISTS (SELECT 1 FROM troubleshooting_tag tt JOIN tag g ON g.id=tt.tag_id WHERE tt.troubleshooting_id=t.id AND g.name=#{tag})
      </if>
      <if test="project != ''">AND t.project=#{project}</if>
      <if test="techStack != ''">AND t.tech_stack LIKE CONCAT('%', #{techStack}, '%') ESCAPE '!'</if>
    </where>
  </sql>
  <select id="findAll" resultType="com.hoseong.devlog.troubleshooting.Troubleshooting">
    SELECT t.* FROM troubleshooting t <include refid="filters"/>
    ORDER BY t.updated_at DESC, t.id DESC LIMIT #{limit} OFFSET #{offset}
  </select>
  <select id="count" resultType="long">SELECT COUNT(*) FROM troubleshooting t <include refid="filters"/></select>
  <select id="findById" resultType="com.hoseong.devlog.troubleshooting.Troubleshooting">SELECT * FROM troubleshooting WHERE id=#{id}</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO troubleshooting (title,symptom,cause,solution,code_snippet,tech_stack,project,prevention)
    VALUES (#{title},#{symptom},#{cause},#{solution},#{codeSnippet},#{techStack},#{project},#{prevention})
  </insert>
  <update id="update">
    UPDATE troubleshooting SET title=#{title},symptom=#{symptom},cause=#{cause},solution=#{solution},
      code_snippet=#{codeSnippet},tech_stack=#{techStack},project=#{project},prevention=#{prevention},updated_at=CURRENT_TIMESTAMP
    WHERE id=#{id}
  </update>
  <delete id="delete">DELETE FROM troubleshooting WHERE id=#{id}</delete>
</mapper>
